{
  "name": "cestou-zimy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --experimental-strip-types server/start.ts",
    "build": "vite build --config app-vite.config.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --experimental-strip-types server/start.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/migrate.ts",
    "seed:demo": "node --env-file-if-exists=.env --experimental-strip-types scripts/seed-demo.ts",
    "keys:generate": "node scripts/generate-keys.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "better-auth": "^1.7.10",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "nodemailer": "^10.1.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}

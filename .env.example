# Prvé nasadenie: https://hub.biketrek.sk/zk
# Neskôr: https://zimnykurz.sk/priprava (vyžaduje verejnú hosting proxy).
# Jediné nastavenie URL riadi runtime aj build; po zmene vždy rebuild + Caddy render.
# Docker príkazy používajú --env-file zk.env. APP_BASE_PATH sa odvodzuje z APP_URL.
APP_URL=
NODE_ENV=
PORT=
HOST=
DATABASE_PATH=
COURSE_ID=
BOOTSTRAP_ADMIN_EMAIL=
# Generuj lokálne: node scripts/generate-keys.mjs >> .env
BETTER_AUTH_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# smtp v produkcii; file je povolené iba vo vývoji.
AUTH_MAIL_MODE=
MAIL_DIRECTORY=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Použiť iba za dôveryhodným Caddy, bez verejného portu kontajnera.
TRUST_PROXY=
# Voliteľne ďalší dôveryhodný vývojový origin; v produkcii nepovoľovať wildcard.
AUTH_TRUSTED_ORIGINS=
